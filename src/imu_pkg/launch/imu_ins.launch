<launch>
  <arg name="config_file" default="$(find imu_pkg)/config/imu_ins_template.yaml" />
  <arg name="serial_port"
       default="/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_AQ00TCCT-if00-port0" />

  <node pkg="imu_pkg"
        type="imu_node.py"
        name="imu_node"
    output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <!-- Override YAML so the IMU port is fixed unless explicitly changed. -->
    <param name="serial_port" value="$(arg serial_port)" />
  </node>

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_link_to_imu"
        args="0.5 0 0.2 0 0 0 base_link imu_link" />
</launch>
