<?xml version="1.0"?>
<launch>
  <!-- Terminal 2 for total.launch: all valid GNSS modes plus outage. -->
  <arg name="raw_fix_topic" default="/gps/fix" />
  <arg name="selected_fix_topic"
       default="/outdoor_waypoint_nav/gps/fix_selected" />
  <arg name="waypoint_file" default="/waypoint_files/points_total.txt" />
  <arg name="gps_message_timeout" default="1.5" />
  <arg name="fixed_max_horizontal_stddev" default="0.20" />
  <arg name="evaluation_enabled" default="true" />
  <arg name="evaluation_output_dir" default="/results" />
  <arg name="evaluation_show_plot" default="false" />
  <arg name="evaluation_finish_delay_sec" default="0.5" />
  <arg name="trajectory_logging_enabled" default="true" />
  <arg name="trajectory_output_dir" default="/results/experiment_runs" />

  <param name="/outdoor_waypoint_nav/coordinates_file"
         value="$(arg waypoint_file)"
         type="string" />
  <param name="/outdoor_waypoint_nav/send_goals_launch_file"
         value="$(find outdoor_waypoint_nav)/launch/include/send_goals_total.launch"
         type="string" />

  <!-- This is the only publisher to the selected fix topic.  It keeps
       covariance unchanged, accepts FIXED/FLOAT/normal, and publishes nothing
       during NO_FIX so EKF prediction can continue cleanly. -->
  <node pkg="outdoor_waypoint_nav"
        type="gnss_state_relay_total.py"
        name="gnss_state_relay_total"
        output="screen">
    <param name="input_topic" value="$(arg raw_fix_topic)" />
    <param name="output_topic" value="$(arg selected_fix_topic)" />
    <param name="state_topic"
           value="/outdoor_waypoint_nav/gps/state_total" />
    <param name="available_topic"
           value="/outdoor_waypoint_nav/gps/available_total" />
    <param name="outage_active_topic"
           value="/outdoor_waypoint_nav/gps/outage_active_total" />
    <param name="message_timeout"
           value="$(arg gps_message_timeout)" type="double" />
    <param name="fixed_max_horizontal_stddev"
           value="$(arg fixed_max_horizontal_stddev)" type="double" />
  </node>

  <include file="$(find outdoor_waypoint_nav)/launch/include/experiment_control_and_evaluation.launch">
    <arg name="joy_control_launch"
         value="$(find outdoor_waypoint_nav)/launch/outdoor/joy_launch_control_total.launch" />
    <arg name="evaluation_enabled" value="$(arg evaluation_enabled)" />
    <arg name="evaluation_output_dir" value="$(arg evaluation_output_dir)" />
    <arg name="evaluation_show_plot" value="$(arg evaluation_show_plot)" />
    <arg name="evaluation_finish_delay_sec"
         value="$(arg evaluation_finish_delay_sec)" />
    <arg name="evaluation_waypoint_file" value="$(arg waypoint_file)" />
    <arg name="evaluation_gps_topic" value="$(arg selected_fix_topic)" />
    <arg name="evaluation_defer_waypoint_load" value="true" />
    <arg name="evaluation_start_on_waypoint_index_zero" value="true" />
    <arg name="trajectory_logging_enabled"
         value="$(arg trajectory_logging_enabled)" />
    <arg name="trajectory_output_dir" value="$(arg trajectory_output_dir)" />
    <arg name="trajectory_waypoint_file" value="$(arg waypoint_file)" />
    <arg name="trajectory_outage_active_topic"
         value="/outdoor_waypoint_nav/gps/outage_active_total" />
    <arg name="trajectory_scenario_name" value="scenario_total" />
    <arg name="trajectory_scenario_metadata"
         value="selected_gnss=all_valid_preserve_covariance;navigation=move_base_lidar;outage=odom_imu_dead_reckoning" />
  </include>
</launch>
