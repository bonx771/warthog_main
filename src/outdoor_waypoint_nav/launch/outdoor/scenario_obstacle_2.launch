<?xml version="1.0"?>
<launch>
  <!--
    Scenario Obstacle 2: LiDAR obstacle avoidance with correlated GNSS noise.

    Terminal 1 must already be running:
      roslaunch outdoor_waypoint_nav outdoor_waypoint_obstacle_2.launch

    This file owns /outdoor_waypoint_nav/gps/fix_selected. Do not run it at
    the same time as scenario_obstacle.launch, which owns the same topic.
  -->
  <arg name="selected_fix_topic"
       default="/outdoor_waypoint_nav/gps/fix_selected" />
  <arg name="waypoint_file"
       default="/waypoint_files/points_obstacle.txt" />

  <!-- Match scenario_2_gnss_noise.launch: clean through WP2, correlated
       noise from WP2 to WP4, then clean again immediately at WP4. -->
  <arg name="alpha" default="0.9" />
  <arg name="innovation_sigma_m" default="3.0" />
  <arg name="activation_mode" default="waypoint_interval" />
  <arg name="noise_start_after_waypoint_index" default="2" />
  <arg name="noise_stop_at_waypoint_index" default="4" />

  <arg name="evaluation_enabled" default="true" />
  <arg name="evaluation_output_dir" default="/results" />
  <arg name="evaluation_show_plot" default="false" />
  <arg name="evaluation_finish_delay_sec" default="0.5" />
  <arg name="trajectory_logging_enabled" default="true" />
  <arg name="trajectory_output_dir" default="/results/experiment_runs" />

  <!-- Configure the obstacle route and make RB/r start the move_base sender
       whose arrival check deliberately uses the raw /gps/fix RTK stream. -->
  <param name="/outdoor_waypoint_nav/coordinates_file"
         value="$(arg waypoint_file)"
         type="string" />
  <param name="/outdoor_waypoint_nav/send_goals_launch_file"
         value="$(find outdoor_waypoint_nav)/launch/include/send_goals_obstacle_gnss_noise.launch"
         type="string" />

  <include file="$(find outdoor_waypoint_nav)/launch/include/gnss_correlated_noise.launch">
    <arg name="input_topic" value="/gps/fix" />
    <arg name="output_topic" value="/gps/fix_noisy" />
    <arg name="alpha" value="$(arg alpha)" />
    <arg name="innovation_sigma_m" value="$(arg innovation_sigma_m)" />
    <arg name="activation_mode" value="$(arg activation_mode)" />
    <arg name="noise_start_after_waypoint_index"
         value="$(arg noise_start_after_waypoint_index)" />
    <arg name="noise_stop_at_waypoint_index"
         value="$(arg noise_stop_at_waypoint_index)" />
  </include>

  <!-- navsat_transform/global EKF sees only this selected, possibly noisy
       stream. /gps/fix remains available as clean RTK reference and arrival
       truth; do not add a second publisher to selected_fix_topic. -->
  <node pkg="topic_tools"
        type="relay"
        name="scenario_obstacle_2_noisy_gps_to_navsat"
        args="/gps/fix_noisy $(arg selected_fix_topic)"
        output="screen" />

  <include file="$(find outdoor_waypoint_nav)/launch/include/experiment_control_and_evaluation.launch">
    <arg name="joy_control_launch"
         value="$(find outdoor_waypoint_nav)/launch/outdoor/joy_launch_control_obstacle.launch" />
    <arg name="evaluation_enabled" value="$(arg evaluation_enabled)" />
    <arg name="evaluation_output_dir" value="$(arg evaluation_output_dir)" />
    <arg name="evaluation_show_plot" value="$(arg evaluation_show_plot)" />
    <arg name="evaluation_finish_delay_sec"
         value="$(arg evaluation_finish_delay_sec)" />
    <arg name="evaluation_waypoint_file" value="$(arg waypoint_file)" />
    <!-- This file can be empty while LB/l is collecting a new route. -->
    <arg name="evaluation_defer_waypoint_load" value="true" />
    <arg name="evaluation_start_on_waypoint_index_zero" value="true" />
    <arg name="trajectory_logging_enabled"
         value="$(arg trajectory_logging_enabled)" />
    <arg name="trajectory_output_dir" value="$(arg trajectory_output_dir)" />
    <arg name="trajectory_waypoint_file" value="$(arg waypoint_file)" />
    <arg name="trajectory_scenario_name" value="scenario_obstacle_2" />
    <arg name="trajectory_scenario_metadata"
         value="selected_gnss=correlated_noisy;reference_gnss=raw_rtk;rtk_arrival_source=/gps/fix;localization_gnss=stationary_gate_motion_aided_kalman;continuous_turn_floor=0.30;navigation=move_base_lidar_static_obstacle_avoidance;alpha=$(arg alpha);innovation_sigma_m=$(arg innovation_sigma_m);activation_mode=$(arg activation_mode);noise_start_after_wp=$(arg noise_start_after_waypoint_index);noise_stop_at_wp=$(arg noise_stop_at_waypoint_index)" />
  </include>
</launch>
