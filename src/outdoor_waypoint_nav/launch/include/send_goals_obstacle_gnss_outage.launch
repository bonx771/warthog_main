<?xml version="1.0"?>
<launch>
  <!--
    Obstacle-avoidance waypoint sender for the GNSS-outage experiment.

    The selected GNSS stream is intentionally silent during the outage, so
    physical waypoint completion uses the independent raw RTK fix. This keeps
    the navigation outage real for navsat/EKF without deadlocking the obstacle
    sender's intermediate/final arrival checks.
  -->
  <arg name="coordinates_file" default="/waypoint_files/points_obstacle.txt" />
  <arg name="reverse_waypoint_order" default="false" />

  <include file="$(find outdoor_waypoint_nav)/launch/include/send_goals_obstacle.launch">
    <arg name="coordinates_file" value="$(arg coordinates_file)" />
    <arg name="reverse_waypoint_order" value="$(arg reverse_waypoint_order)" />
    <arg name="rtk_fix_topic" value="/gps/fix" />
  </include>
</launch>
