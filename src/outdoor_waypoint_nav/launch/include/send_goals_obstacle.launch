<?xml version="1.0"?>

<!--
  Waypoint sender for LiDAR obstacle avoidance.

  Keep every normal waypoint setting from send_goals.launch, but hand each
  waypoint to move_base instead of using direct-pursuit /cmd_vel control.
  move_base can then plan around static obstacles in the LiDAR costmaps.
-->
<launch>

  <arg name="coordinates_file" default="/waypoint_files/points_obstacle.txt" />
  <!-- Keep this configurable so GNSS-degradation scenarios can feed noisy
       fixes to localization while waypoint arrival still uses raw RTK. -->
  <arg name="rtk_fix_topic"
       default="/outdoor_waypoint_nav/gps/fix_selected" />

  <include file="$(find outdoor_waypoint_nav)/launch/include/send_goals.launch">
    <arg name="coordinates_file" value="$(arg coordinates_file)" />
  </include>

  <!-- roslaunch loads these parameters before it starts gps_waypoint. -->
  <param name="/outdoor_waypoint_nav/direct_waypoint_drive_enabled"
         value="false"
         type="bool" />
  <param name="/outdoor_waypoint_nav/waypoint_cmd_topic"
         value="/cmd_vel_raw_obstacle"
         type="string" />
  <!-- RTK position alone determines completion. Do not resend a near-goal
       heading or require the robot to rotate at any waypoint. -->
  <param name="/outdoor_waypoint_nav/waypoint_goal_heading_enabled"
         value="false"
         type="bool" />
  <param name="/outdoor_waypoint_nav/waypoint_pre_align_enabled"
         value="true"
         type="bool" />
  <!-- Coarse IMU-yaw turn before a sharp segment. It deliberately exits with
       a large residual error; this is path alignment, not waypoint-heading
       accuracy. The direction is latched so +/-pi noise cannot reverse it. -->
  <param name="/outdoor_waypoint_nav/waypoint_pre_align_angle_threshold"
         value="1.309"
         type="double" />
  <param name="/outdoor_waypoint_nav/waypoint_pre_align_exit_angle_threshold"
         value="0.524"
         type="double" />
  <param name="/outdoor_waypoint_nav/waypoint_pre_align_min_goal_distance"
         value="0.80"
         type="double" />
  <param name="/outdoor_waypoint_nav/waypoint_pre_align_angular_kp"
         value="0.45"
         type="double" />
  <param name="/outdoor_waypoint_nav/waypoint_pre_align_min_angular_speed"
         value="0.25"
         type="double" />
  <param name="/outdoor_waypoint_nav/waypoint_pre_align_max_angular_speed"
         value="0.40"
         type="double" />
  <param name="/outdoor_waypoint_nav/waypoint_pre_align_timeout"
         value="20.0"
         type="double" />
  <!-- 1.15 m is slightly larger than the padded footprint's swept radius. -->
  <param name="/outdoor_waypoint_nav/waypoint_pre_align_min_scan_clearance"
         value="1.15"
         type="double" />
  <param name="/outdoor_waypoint_nav/waypoint_pre_align_scan_timeout"
         value="0.50"
         type="double" />
  <!-- RTK is the source of truth for physical waypoint completion. Intermediate
       points hand off at 0.50 m; the final point uses a 0.30 m
       radius. Heading is ignored for both cases. -->
  <param name="/outdoor_waypoint_nav/rtk_arrival_enabled"
         value="true"
         type="bool" />
  <param name="/outdoor_waypoint_nav/rtk_fix_topic"
         value="$(arg rtk_fix_topic)"
         type="string" />
  <param name="/outdoor_waypoint_nav/rtk_fix_timeout"
         value="1.0"
         type="double" />
  <param name="/outdoor_waypoint_nav/rtk_max_horizontal_stddev"
         value="0.20"
         type="double" />
  <param name="/outdoor_waypoint_nav/rtk_arrival_radius"
         value="0.50"
         type="double" />
  <param name="/outdoor_waypoint_nav/rtk_final_arrival_radius"
         value="0.30"
         type="double" />
  <param name="/outdoor_waypoint_nav/rtk_arrival_hold_time"
         value="0.0"
         type="double" />

</launch>
